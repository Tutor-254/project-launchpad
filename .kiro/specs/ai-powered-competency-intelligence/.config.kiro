  "risks": [
    {
      "risk": "AI generates poor quality assessments",
      "mitigation": "Instructor review before use; quality validation checklist; feedback loop to improve prompts"
    },
    {
      "risk": "Cost overruns on API calls",
      "mitigation": "Budget caps; rate limiting; usage alerts; cost dashboard"
    },
    {
      "risk": "Learner data privacy concerns",
      "mitigation": "Anonymization; transparency disclosure; opt-out option; audit trail"
    },
    {
      "risk": "API downtime",
      "mitigation": "Fallback to manual processes; offline assessment templates; graceful error messages"
    },
    {
      "risk": "Bias in AI-generated content",
      "mitigation": "Bias testing; diverse question coverage; human review; appeal process"
    }
  ],
  "successMetrics": [
    "Assessment generation time <60s (async)",
    "Instructor satisfaction >4/5",
    "Learner satisfaction with AI feedback >4/5",
    "Assessment quality (instructor pass rate) >85%",
    "Cost per assessment <$0.10",
    "Job queue success rate >99%"
  ],
  "technologies": [
    "Google Gemini API",
    "Supabase Edge Functions",
    "PostgreSQL Triggers",
