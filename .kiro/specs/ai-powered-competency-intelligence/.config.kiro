  "keyFeatures": [
    "Assessment Generation (Diagnostic, CAT 1, CAT 2)",
    "Facilitator Screening & AI-Powered Evaluation",
    "Course Intelligence Extraction",
    "Personalized Feedback Generation",
    "Intelligent Tutoring & Hints",
    "Content Quality Audit",
